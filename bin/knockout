#!/usr/bin/env ruby
# This app is a raft. — 이 앱도 뗏목이다.
#
# 수묵 그림의 흰 배경을 진짜 투명으로 바꾼다. 그러면 어떤 바탕에도 그대로 얹힌다.
#
#   bin/knockout app/assets/images/compound_src.png app/assets/images/compound.png
#   bin/knockout app/assets/images/maitreya_src.png app/assets/images/maitreya.png --connected --crop
#
#   --connected  가장자리에서 이어진 바탕만 걷는다. 그림 안에 바탕과 거의 같은
#                흰빛이 있을 때(미륵의 몸) 그 안이 뚫리지 않게 한다.
#   --crop       남은 그림의 경계(알파가 있는 곳)에 맞춰 여백을 자른다.
#   --region=x,y,w,h  걷기 전에 원본의 이 부분만 쓴다(원본 대비 비율). 한 장에
#                여럿이 그려져 있을 때 하나씩 나누어 쓴다.
#
#   bin/knockout app/assets/images/four_kings.png app/assets/images/four_king_left.png \
#     --region=0.163,0.283,0.192,0.585 --connected
#
# 배경색(기본 #F5F5F5) 언저리(±TOLERANCE)는 투명, 거기서 FEATHER 만큼 떨어질
# 때까지 알파를 서서히 올린다. 가장자리의 반투명 화소는 배경과 섞이기 전의
# 먹색으로 되돌린다 — 그래야 먹선이 회색으로 뭉개지지 않는다.
# 그림이 바뀌면 다시 돌린다. 바깥 것은 쓰지 않는다 — zlib 뿐이다.
require "zlib"

flags, args = ARGV.partition { |arg| arg.start_with?("--") }
SRC, OUT, COLOR = args
abort "쓰는 법: bin/knockout 원본.png 결과.png [배경색 #RRGGBB] [--connected] [--crop] [--region=x,y,w,h]" unless SRC && OUT

BACKGROUND = (COLOR || "#F5F5F5").delete("#").scan(/../).map { |h| h.to_i(16) }
CONNECTED = flags.include?("--connected")
CROP = flags.include?("--crop")
REGION = flags.find { |flag| flag.start_with?("--region=") }&.delete_prefix("--region=")&.split(",")&.map(&:to_f)
TOLERANCE = 8
FEATHER = 28

def chunks(png)
  raise "PNG 가 아니다" unless png.byteslice(0, 8) == "\x89PNG\r\n\x1a\n".b
  pos = 8
  Enumerator.new do |y|
    while pos < png.bytesize
      length = png.byteslice(pos, 4).unpack1("N")
      y << [ png.byteslice(pos + 4, 4), png.byteslice(pos + 8, length) ]
      pos += 12 + length
    end
  end
end

def paeth(a, b, c)
  p = a + b - c
  pa, pb, pc = (p - a).abs, (p - b).abs, (p - c).abs
  pa <= pb && pa <= pc ? a : (pb <= pc ? b : c)
end

png = File.binread(SRC)
width = height = depth = color = nil
idat = +""
chunks(png).each do |type, body|
  case type
  when "IHDR" then width, height, depth, color = body.unpack("NNCC")
  when "IDAT" then idat << body
  end
end
abort "8비트 RGB 나 RGBA 만 다룬다" unless depth == 8 && [ 2, 6 ].include?(color)

bpp = color == 6 ? 4 : 3
stride = width * bpp
raw = Zlib::Inflate.inflate(idat)
rows = []
prev = "\0".b * stride
offset = 0
height.times do
  filter = raw.getbyte(offset)
  line = raw.byteslice(offset + 1, stride).bytes
  offset += 1 + stride
  stride.times do |x|
    a = x >= bpp ? line[x - bpp] : 0
    b = prev.getbyte(x)
    c = x >= bpp ? prev.getbyte(x - bpp) : 0
    line[x] = case filter
    when 1 then line[x] + a
    when 2 then line[x] + b
    when 3 then line[x] + (a + b) / 2
    when 4 then line[x] + paeth(a, b, c)
    else line[x]
    end & 255
  end
  prev = line.pack("C*")
  rows << line
end

if REGION
  rx, ry, rw, rh = REGION
  left = (rx * width).round
  top = (ry * height).round
  cut_w = (rw * width).round.clamp(1, width - left)
  cut_h = (rh * height).round.clamp(1, height - top)
  rows = rows[top, cut_h].map { |line| line[left * bpp, cut_w * bpp] }
  width, height = cut_w, cut_h
end

# 배경에서 얼마나 떨어졌는가 — 세 채널 가운데 가장 먼 것을 알파로.
alphas = rows.map do |line|
  (0...width).map do |x|
    r, g, b = line[x * bpp, 3]
    distance = [ (r - BACKGROUND[0]).abs, (g - BACKGROUND[1]).abs, (b - BACKGROUND[2]).abs ].max
    ((distance - TOLERANCE).clamp(0, FEATHER) * 255.0 / FEATHER).round
  end
end

# 이어진 바탕만 — 가장자리의 바탕빛에서 출발해 바탕빛(알파가 온전하지 않은
# 곳)을 따라서만 번진다. 먹선에 막힌 안쪽의 흰빛은 그대로 남는다.
if CONNECTED
  reached = Array.new(height) { Array.new(width, false) }
  queue = []
  seed = ->(x, y) { queue << [ x, y ] if alphas[y][x] < 255 && !reached[y][x] && (reached[y][x] = true) }
  (0...width).each { |x| seed.call(x, 0); seed.call(x, height - 1) }
  (0...height).each { |y| seed.call(0, y); seed.call(width - 1, y) }
  until queue.empty?
    x, y = queue.pop
    seed.call(x - 1, y) if x > 0
    seed.call(x + 1, y) if x < width - 1
    seed.call(x, y - 1) if y > 0
    seed.call(x, y + 1) if y < height - 1
  end
  alphas.each_with_index { |row, y| row.each_index { |x| row[x] = 255 unless reached[y][x] } }
end

left, top, right, bottom = 0, 0, width - 1, height - 1
if CROP
  kept = alphas.each_with_index.flat_map { |row, y| row.each_index.select { |x| row[x] > 0 }.map { |x| [ x, y ] } }
  abort "남는 그림이 없다" if kept.empty?
  left, right = kept.map(&:first).minmax
  top, bottom = kept.map(&:last).minmax
end

out = +""
cleared = 0
(top..bottom).each do |y|
  line = rows[y]
  out << "\0"
  (left..right).each do |x|
    r, g, b = line[x * bpp, 3]
    alpha = alphas[y][x]
    if alpha.zero?
      cleared += 1
      out << [ 0, 0, 0, 0 ].pack("C4")
    elsif alpha < 255
      # 배경과 섞이기 전의 색으로 되돌린다: c = a·ink + (1 − a)·bg.
      k = alpha / 255.0
      ink = [ r, g, b ].zip(BACKGROUND).map { |ch, bg| ((ch - (1 - k) * bg) / k).round.clamp(0, 255) }
      out << (ink + [ alpha ]).pack("C4")
    else
      out << [ r, g, b, 255 ].pack("C4")
    end
  end
end
width = right - left + 1
height = bottom - top + 1

chunk = ->(type, data) { [ data.bytesize ].pack("N") + type + data + [ Zlib.crc32(type + data) ].pack("N") }
File.binwrite(OUT, "\x89PNG\r\n\x1a\n".b +
  chunk.call("IHDR", [ width, height, 8, 6, 0, 0, 0 ].pack("NNCCCCC")) +
  chunk.call("IDAT", Zlib::Deflate.deflate(out, Zlib::BEST_COMPRESSION)) +
  chunk.call("IEND", ""))

puts "#{OUT}: #{width}×#{height}, 투명해진 화소 #{(cleared * 100.0 / (width * height)).round}%"
