#!/usr/bin/env bash
# This app is a raft. — 이 앱도 뗏목이다.
#
# 밤마다 한 번. 뜨기 → 암호화 → 서버 밖으로.
#
# 열쇠는 만든 사람만 갖는다. 서버에는 공개키(인증서)만 둔다 — 서버가 털려도 백업은
# 열리지 않는다. 앱이 실행할 때 부르는 것이 아니라 서버의 도구이므로 §6 와 무관하다.
# 백업에는 사용자의 것이 통째로 들어 있다(§4) — 암호화하지 않은 채로 서버 밖에 두지 않는다.
#
#   bin/backup                  뜨고 암호화한다(보낼 곳이 정해졌으면 보낸다)
#   BACKUP_KEEP=14 bin/backup   서버에 남기는 날수(기본 7)
#
# 필요한 것
#   BACKUP_CERT   공개키 인증서의 자리(기본 /rails/backup/backup-cert.pem)
#   BACKUP_DIR    뜬 것을 두는 자리(기본 /rails/backup)
#   BACKUP_REMOTE rclone 의 이름 — 서버와 다른 한국 회사의 오브젝트 스토리지(DEPLOY.md §9, 2026-11-11 정함)
#   BACKUP_REPO   (물린 길) 사설 깃허브 저장소. 둘 다 비어 있으면 서버에만 둔다(아래 「보내기」).
set -euo pipefail

DB="${DATABASE_PATH:-/rails/storage/production.sqlite3}"
DIR="${BACKUP_DIR:-/rails/backup}"
CERT="${BACKUP_CERT:-$DIR/backup-cert.pem}"
KEEP="${BACKUP_KEEP:-7}"
STAMP="$(date -u +%Y%m%d-%H%M%S)"
NAME="fulltimezero-$STAMP.sqlite3"

mkdir -p "$DIR"
[ -f "$DB" ] || { echo "데이터베이스가 없다: $DB" >&2; exit 1; }
[ -f "$CERT" ] || { echo "공개키 인증서가 없다: $CERT (DEPLOY.md 의 「백업의 열쇠」)" >&2; exit 1; }

# 1. 뜨기 — 쓰는 중에도 안전한 방법은 .backup 뿐이다. 파일을 그냥 복사하지 않는다.
sqlite3 "$DB" ".backup '$DIR/$NAME'"

# 2. 암호화 — 공개키로. 서버에는 여는 열쇠가 없다.
openssl cms -encrypt -binary -aes-256-cbc -in "$DIR/$NAME" -outform DER \
            -out "$DIR/$NAME.cms" -recip "$CERT"
rm -f "$DIR/$NAME"
echo "떴다: $DIR/$NAME.cms ($(du -h "$DIR/$NAME.cms" | cut -f1))"

# 3. 보내기 — 서버 밖으로.
#
#    쓰는 길: rclone(BACKUP_REMOTE) — 서버와 다른 한국 회사의 오브젝트 스토리지. 서버의 키는
#    그 버킷에 쓰기만 한다. 지난 판을 지우는 것은 그 회사 쪽 수명 주기가 한다(DEPLOY.md §9).
#    물린 길: 사설 깃허브 저장소(BACKUP_REPO) — 나라 밖이고 깃 역사가 무거워진다. 남겨만 둔다.
#    아무것도 없으면 서버에 둔 채로 둔다 — 서버가 사라지면 백업도 사라진다는 뜻이다.
if [ -n "${BACKUP_REPO:-}" ]; then
  CLONE="${BACKUP_CLONE:-$DIR/repo}"
  [ -d "$CLONE/.git" ] || git clone --depth 1 "$BACKUP_REPO" "$CLONE"
  cp "$DIR/$NAME.cms" "$CLONE/fulltimezero.sqlite3.cms"
  git -C "$CLONE" add fulltimezero.sqlite3.cms
  # 같은 날 두 번 떠도 바뀐 것이 없으면 커밋하지 않는다.
  if git -C "$CLONE" diff --cached --quiet; then
    echo "바뀐 것이 없다 — 올리지 않는다."
  else
    git -C "$CLONE" -c user.name="fulltimezero" -c user.email="backup@fulltimezero" \
        commit -q -m "밤의 백업 — $STAMP"
    git -C "$CLONE" push -q origin HEAD
    echo "올렸다: $BACKUP_REPO (fulltimezero.sqlite3.cms)"
  fi
elif [ -n "${BACKUP_REMOTE:-}" ]; then
  rclone copy "$DIR/$NAME.cms" "$BACKUP_REMOTE" --no-traverse
  echo "보냈다: $BACKUP_REMOTE/$NAME.cms"
else
  echo "보낼 곳이 없다(BACKUP_REPO · BACKUP_REMOTE). 서버에만 남는다 — DEPLOY.md 의 「백업을 둘 곳」."
fi

# 4. 서버에 남기는 것은 며칠 치뿐. 밖에 보낸 것은 그쪽 규칙을 따른다.
find "$DIR" -name "fulltimezero-*.sqlite3.cms" -type f -mtime "+$KEEP" -delete
