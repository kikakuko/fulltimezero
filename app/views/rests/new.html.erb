<%# 손님은 보되 쓰지 못한다. 저장되는 길은 404 이고(컨트롤러), 여기서는
    쌓는 손짓을 아예 보이지 않는다 — 눌러도 남지 않기 때문이다. %>
<% if guest? %>
  <div class="guide"><p><%= t("guest.only_looking") %></p></div>
<% else %>
<%= form_with model: @rest, url: rests_path do |f| %>
  <%= render "shared/errors", record: @rest %>

  <h1 class="title"><%= t("rests.new.duration_question") %></h1>
  <ul class="choices">
    <% Rest::DURATIONS.each do |value| %>
      <li>
        <%= f.label "duration_#{value}" do %>
          <%= f.radio_button :duration, value, required: true %>
          <%= t("rests.durations.#{value}") %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <h2 class="title"><%= t("rests.new.texture_question") %></h2>
  <ul class="choices">
    <% Rest::TEXTURES.each do |value| %>
      <li>
        <%= f.label "texture_#{value}" do %>
          <%= f.radio_button :texture, value %>
          <%= t("rests.textures.#{value}") %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <p style="margin-top:3rem"><%= f.button t("rests.new.submit"), class: "button-primary" %></p>
<% end %>
<% end %>
