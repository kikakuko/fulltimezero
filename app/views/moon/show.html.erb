<div class="center">
  <%= moon_svg(@moon.fraction, size: 120) %>

  <div class="trail" role="img" aria-label="<%= t("moon.trail_label") %>">
    <% @moon.days.each do |day| %>
      <span class="<%= day.rested? ? "on" : "off" %>"></span>
    <% end %>
  </div>

  <p class="tiny"><%= t("moon.window") %></p>
</div>
