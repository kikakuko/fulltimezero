<%# 셋째 문 뒤의 한 화면. 계정이 있으면 들어가고, 없으면 여기서 생긴다 —
    이메일과 비밀번호, 그것뿐이다. 확인 칸도 「이미 계정이 있다」도 없다. %>
<p class="lead center"><%= t("gate.line") %></p>

<h1 class="title"><%= t("users.new.title") %></h1>

<%= form_with model: @user, url: users_path do |f| %>
  <%= render "shared/errors", record: @user %>

  <div class="field">
    <%= f.label :email_address, t("users.email") %>
    <%= f.email_field :email_address, autofocus: true, autocomplete: "username", required: true %>
  </div>

  <div class="field">
    <%= f.label :password, t("users.password") %>
    <%= f.password_field :password, autocomplete: "current-password", required: true %>
  </div>

  <p class="tiny"><%= t("users.new.only_email") %></p>

  <%= f.hidden_field :time_zone, data: { controller: "time-zone" } %>

  <p style="margin-top:2.5rem"><%= f.submit t("users.new.submit") %></p>
<% end %>

<p class="tiny"><%= link_to t("sessions.new.forgot"), new_password_path %></p>
