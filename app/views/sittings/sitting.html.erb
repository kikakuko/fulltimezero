<%# 앉는 중. 달이 차오른다. 숫자도, 막대도 없다.
    한 줄만 잠시 떴다 사라진다 — 지켜보지 않아도 된다는 말. %>
<% content_for :no_chrome, true %>
<% content_for :no_locales, true %>

<div class="night"
     data-controller="bell sitting"
     data-action="bell:close->bell#closing"
     data-bell-enabled-value="<%= @bell %>"
     data-bell-end-url-value="<%= bell_source(:end) %>"
     data-bell-measure-value="<%= Rails.env.development? %>"
     data-sitting-elapsed-value="<%= @elapsed %>"
     data-sitting-total-value="<%= @length.seconds %>"
     data-sitting-open-value="<%= @length.open? %>"
     data-sitting-size-value="200">

  <div class="center">
    <%= moon_svg(0.0, size: 200, title: t("sittings.sitting"),
                 class: "terminator", data: { sitting_target: "terminator" }) %>

    <p class="hint"><%= t("sittings.hint") %></p>
  </div>

  <%= button_to t("sittings.finish"), sitting_path(@sitting), method: :patch,
                class: "quiet",
                form: { class: "leave", data: { sitting_target: "form" } } %>
</div>
