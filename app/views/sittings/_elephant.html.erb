<%# 코끼리의 길. 검은 코끼리가 앉은 날만큼 희어지며 길을 오른다.
    길은 그리지 않는다 — 시각적 길은 배경 그림 안에 있다. 정거장 아홉은
    지명이지 경지가 아니다. 이름을 누르면 그 자리를 읽는 곳으로 간다.
    숫자는 없다. 아홉 자리와 코끼리의 자리를 잇는 코드는 없다. %>
<div class="elephant-field" data-controller="elephant"
     data-elephant-whiteness-value="<%= reading.whiteness %>"
     data-elephant-yesterday-value="<%= reading.yesterday %>"
     data-elephant-moving-value="<%= moving %>">
  <svg class="elephant-field__map" viewBox="0 0 <%= Elephant::VIEW.join(" ") %>" aria-hidden="false">
    <path class="elephant-field__path" data-elephant-target="path" d=""/>
    <% abidings.each_with_index do |abiding, index| %>
      <% x, y = anchors.fetch(index) %>
      <a href="<%= abiding_path(abiding) %>" class="elephant-field__stop">
        <text class="elephant-field__station" x="<%= x %>" y="<%= y + 44 %>" text-anchor="middle"><%= abiding.name %></text>
      </a>
    <% end %>
  </svg>

  <%# 자리 틀 — 길 위의 자리 · 비스듬함 · 방향. 그 안의 코끼리는 부위별로 걷는다.
      아홉째 정거장에 닿으면 형상을 잃는다 — 흩어지는 것이지 사라지는 것이 아니다. %>
  <div class="elephant-place" data-elephant-target="figure">
    <span class="elephant-place__shadow" aria-hidden="true"></span>
    <div class="elephant-place__turn">
      <%= elephant_figure ele: reading.whiteness, walking: true, label: t("sittings.elephant.alt"),
                          scattered: (reading.station == Elephant::STATIONS - 1 ? (moving ? :now : :already) : nil) %>
    </div>
  </div>
</div>

<%# 한 줄. 이름은 어려운 말 그대로 두고, 곁에 늘 그 자리의 한 줄. %>
<% if (station = abidings[reading.station]) %>
  <p class="quote"><%= t("sittings.elephant.card", station: "#{station.name}(#{station.han})", line: station.one_line_here) %></p>
<% end %>
