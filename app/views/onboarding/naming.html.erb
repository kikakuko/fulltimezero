<%# 둘째 문 — 무엇이 움직이는가. 설문이 아니다. 선택지도, 태그도, 분류도,
    예시 문구도 없다. 한 줄을 적거나, 비워 두고 지나간다. %>
<% content_for :no_chrome, true %>
<% content_for :no_locales, true %>

<%= render "gates", state: "naming" %>

<div class="threshold threshold--naming" data-controller="gates" data-gates-state-value="naming">
  <%# 계정이 있든 없든 같은 칸이다. 없으면 세션이 들고 있는다.
      손님은 여기 서지 않는다 — 첫째 문에서 한 자리로 지난다(onboarding#naming 이 돌려보낸다). %>
  <%= form_with scope: :user, url: threshold_naming_path, method: :patch, class: "threshold__form" do |f| %>
    <%= f.label :what_moves, t("threshold.naming.question"), class: "gates__line" %>
    <%= f.text_field :what_moves, value: @what_moves, maxlength: User::WHAT_MOVES_MOST, autocomplete: "off",
                     class: "threshold__field" %>
    <p class="threshold__way"><%= f.button t("threshold.naming.go"), class: "button-primary" %></p>
  <% end %>

  <%= render "later" %>
</div>
