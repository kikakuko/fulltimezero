<%# 셋째 문 — 몸으로 하는 일. 화면에 손을 얹고 있는 동안 화면이 천천히
    밝아졌다 어두워지기를 세 번. 떼면 처음부터. 세 번을 마치면 그냥
    열린다 — 잘했다는 말은 하지 않는다. %>
<% content_for :no_chrome, true %>
<% content_for :no_locales, true %>

<div class="threshold threshold--breath" data-controller="breath"
     data-action="pointerdown->breath#hold pointerup->breath#release pointercancel->breath#release pointerleave->breath#release animationend->breath#open">
  <p class="threshold__line"><%= t("threshold.breath.line") %></p>

  <%= form_with url: threshold_passed_path, data: { breath_target: "gate" } do %><% end %>

  <%= render "later" %>
</div>
