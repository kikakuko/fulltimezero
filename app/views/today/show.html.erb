<% if @just_recorded %>
  <%# 오늘 몫은 끝났다. 이 화면에는 할 일이 없다(제2조).
      스물여드레의 달이 보름에 닿았다면, 그 한 번만 웃는다. %>
  <% content_for :no_chrome, true %>
  <% content_for :no_locales, true %>
  <div class="center">
    <%= moon_svg(@moon.fraction, moonlight: @moon.full_moon?) %>
    <% if @moon.full_moon? %>
      <p class="lead"><%= t("moon.full") %></p>
    <% end %>
    <p class="lead"><%= t("today.done") %></p>
  </div>
<% else %>
  <%# 마당 — 삼문을 지나면 서는 곳. 맨 위에 경내 조감도, 전각으로 가는 길은 이름뿐. %>
  <%= render "compound" %>

  <div class="center<%= " cleared" if @cleared_morning %>">
    <%# 한 줄까지만. 오늘의 말이 있으면 그것이 계절의 인사보다 앞선다. %>
    <% if @day_line || @greeting %>
      <p class="tiny"><%= t(@day_line || "greetings.#{@greeting}") %></p>
    <% end %>

    <%= moon_svg(@moon.fraction) %>

    <%# 오늘 이미 고요했다면 물음이 조름이 되지 않게 달리 묻는다. %>
    <p class="lead"><%= @quiet ? t("today.already_quiet") : t("today.question") %></p>

    <%# 전각으로 가는 길은 조감도에 있다. 여기에는 쉼 기록만. %>
    <% if @quiet %>
      <p class="tiny"><%= link_to t("today.rested"), new_rest_path, class: "soft" %></p>
    <% else %>
      <p><%= link_to t("today.rested"), new_rest_path, class: "action" %></p>
    <% end %>

    <%# 오늘을 비우는 선언. 앱의 한가운데 행위이므로 여기 둔다 — 날들의
        하루 화면까지 세 번 눌러 들어가 있을 일이 아니다.
        일정이 있어도 비울 수 있다. 비움은 사실의 보고가 아니라 선언이다.
        지키지 못해도 아무 일 없다(제5조 · 제6조). %>
    <div class="tiny clearing" id="clearing" data-controller="maitreya">
      <%= button_to t(@cleared_today ? "today.unclear" : "today.clear"),
                    day_path(Current.user.today, from: "today"), method: :patch, class: "quiet",
                    data: { action: "click->clearing#declare click->bell#open click->maitreya#rise" },
                    form: { data: { controller: "clearing bell",
                                    clearing_vibrate_value: @vibrate, clearing_declaring_value: !@cleared_today,
                                    bell_enabled_value: @clearing_bell && !@cleared_today,
                                    bell_start_url_value: bell_source(:start) } } %>

      <%# 미륵이 솟는 장면. 누르는 순간 마당이 물러나고 땅과 미륵만 남는다.
          넉 초에 전부 멎는다. 한 줄은 처음 비운 날과 다 올라온 날에만. %>
      <% if @maitreya_rise %>
        <% before, after = @maitreya_rise %>
        <template data-maitreya-target="scene">
          <div class="maitreya-scene" role="presentation">
            <div class="maitreya-scene__ground">
              <%= render "days/maitreya", reading: after, before: before %>
            </div>
            <div class="maitreya-scene__below">
              <% if after.first || after.whole %>
                <p class="maitreya-scene__line"><%= t("maitreya.line") %></p>
              <% end %>
              <p class="maitreya-scene__back"><%= link_to t("maitreya.back"), today_path, class: "soft" %></p>
            </div>
          </div>
        </template>
      <% end %>
    </div>
  </div>
<% end %>
