<% if @just_recorded %>
  <%# 오늘 몫은 끝났다. 이 화면에는 할 일이 없다(제2조).
      스물여드레의 달이 보름에 닿았다면, 그 한 번만 웃는다. %>
  <% content_for :no_chrome, true %>
  <% content_for :no_locales, true %>
  <div class="center">
    <%= moon_svg(@moon.fraction, moonlight: @moon.full_moon?) %>
    <% if @moon.full_moon? %>
      <p class="lead"><%= t("moon.full") %></p>
    <% end %>
    <p class="lead"><%= t("today.done") %></p>
  </div>
<% else %>
  <div class="center<%= " cleared" if @cleared_morning %>">
    <%# 한 줄까지만. 오늘의 말이 있으면 그것이 계절의 인사보다 앞선다. %>
    <% if @day_line || @greeting %>
      <p class="tiny"><%= t(@day_line || "greetings.#{@greeting}") %></p>
    <% end %>

    <%= moon_svg(@moon.fraction) %>

    <%# 오늘 이미 고요했다면 물음이 조름이 되지 않게 달리 묻는다. %>
    <p class="lead"><%= @quiet ? t("today.already_quiet") : t("today.question") %></p>

    <% if @quiet %>
      <p class="tiny">
        <%= link_to t("today.rested"), new_rest_path, class: "soft" %>
        &nbsp;·&nbsp;
        <%= link_to t("today.sit"), new_sitting_path, class: "soft" %>
      </p>
    <% else %>
      <p><%= link_to t("today.rested"), new_rest_path, class: "action" %></p>
      <p class="tiny" style="margin-top:2.5rem">
        <%= link_to t("today.sit"), new_sitting_path, class: "soft" %>
      </p>
    <% end %>

    <%# 오늘을 비우는 선언. 앱의 한가운데 행위이므로 여기 둔다 — 날들의
        하루 화면까지 세 번 눌러 들어가 있을 일이 아니다.
        일정이 있어도 비울 수 있다. 비움은 사실의 보고가 아니라 선언이다.
        지키지 못해도 아무 일 없다(제5조 · 제6조). %>
    <p class="tiny clearing">
      <%= button_to t(@cleared_today ? "today.unclear" : "today.clear"),
                    day_path(Current.user.today, from: "today"), method: :patch, class: "quiet" %>
    </p>

    <%# 「쉼의 안내」는 문이 아니라 여기서 내려가는 길이다. %>
    <p class="tiny way"><%= link_to t("nav.guide"), guide_path, class: "soft" %></p>
  </div>
<% end %>
