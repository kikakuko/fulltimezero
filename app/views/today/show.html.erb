<% if @just_recorded %>
  <%# 오늘 몫은 끝났다. 이 화면에는 할 일이 없다(제2조). %>
  <% content_for :no_chrome, true %>
  <% content_for :no_locales, true %>
  <div class="center">
    <%= moon_svg(@moon.fraction) %>
    <p class="lead"><%= t("today.done") %></p>
  </div>
<% else %>
  <div class="center">
    <%= moon_svg(@moon.fraction) %>

    <%# 오늘 이미 고요했다면 물음이 조름이 되지 않게 달리 묻는다. %>
    <p class="lead"><%= @quiet ? t("today.already_quiet") : t("today.question") %></p>

    <% if @quiet %>
      <p class="tiny">
        <%= link_to t("today.rested"), new_rest_path, class: "soft" %>
        &nbsp;·&nbsp;
        <%= link_to t("today.sit"), new_sitting_path, class: "soft" %>
      </p>
    <% else %>
      <p><%= link_to t("today.rested"), new_rest_path, class: "action" %></p>
      <p class="tiny" style="margin-top:2.5rem">
        <%= link_to t("today.sit"), new_sitting_path, class: "soft" %>
      </p>
    <% end %>
  </div>
<% end %>
