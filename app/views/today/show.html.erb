<% if @just_recorded %>
  <%# 오늘 몫은 끝났다. 이 화면에는 할 일이 없다(제2조).
      스물여드레의 달이 보름에 닿았다면, 그 한 번만 웃는다. %>
  <% content_for :no_chrome, true %>
  <% content_for :no_locales, true %>
  <div class="center">
    <%# 달이 응답한다 — 오늘이 이 쉼으로 처음 고요해졌으면 하루치가 눈앞에서 찬다. %>
    <%= moon_svg(@moon.fraction, moonlight: @moon.full_moon?, from: @moon_from) %>
    <% if @moon.full_moon? %>
      <p class="lead"><%= t("moon.full") %></p>
    <% end %>
    <p class="lead"><%= t("today.done") %></p>
    <%# 할 일은 없지만 길은 있다 — 마당으로 돌아가는 조용한 한 줄. 손짓이 아니라 문이다. %>
    <p class="tiny"><%= link_to t("today.back"), today_path, class: "soft" %></p>
  </div>
<% else %>
  <%# 마당 — 삼문을 지나면 서는 곳. 맨 위에 경내 조감도, 전각으로 가는 길은 이름뿐. %>
  <%= render "compound" %>

  <div class="center<%= " cleared" if @cleared_morning %>">
    <%# 한 줄까지만. 오늘의 말이 있으면 그것이 계절의 인사보다 앞선다. %>
    <% if @day_line || @greeting %>
      <p class="tiny"><%= t(@day_line || "greetings.#{@greeting}") %></p>
    <% end %>

    <%# 마당의 달은 조감도 아래에 작게 — 전경보다 커지지 않는다. %>
    <%= moon_svg(@moon.fraction, size: 104) %>

    <%# 오늘 이미 고요했다면 물음이 조름이 되지 않게 달리 묻는다. %>
    <p class="lead"><%= @quiet ? t("today.already_quiet") : t("today.question") %></p>

    <%# 전각으로 가는 길은 조감도에 있다. 여기에는 쉼 기록만.
        손님에게는 쌓는 손짓을 보이지 않는다 — 눌러도 남지 않기 때문이다. %>
    <%# 틈틈이 쉼 — 마당의 달은 짧은 일상의 짧은 쉼을 센다. 손짓은 낙관 같은 붓 한 자 「쉼」
        하나다. 그림 기호가 아니라 글자다 — 이 앱의 아이콘은 글자다. 누르면 묻지 않고 바로
        틈 하나가 남는다(길이도 결도 없다). 첫 틈에만 달이 응답하고, 그 뒤의 틈은 낙관이
        찍히는 느낌만(rest--stamped). 길이와 결을 적는 자리는 미륵당의 하루에 있다.
        오늘을 비워 두는 선언도 거기서 한다(2026-10-08). 손님은 누르면 구경하는 자리 한 줄. %>
    <% if guest? %>
      <p class="rest" id="rest"><%= link_to t("today.rested"), new_rest_path, class: "seal rested" %></p>
    <% else %>
      <%= button_to t("today.rested"), rests_path, class: "seal rested",
                    form: { id: "rest", class: class_names("rest", "rest--stamped": flash[:stamped]) } %>
    <% end %>
  </div>
<% end %>
