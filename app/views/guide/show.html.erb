<%# 다섯 장. 번호는 글자로 적는다 — 숫자는 화면에 두지 않는다. %>
<h1 class="title"><%= t("guide.title") %></h1>

<ul class="chapters">
  <% @chapters.each_with_index do |key, index| %>
    <li>
      <span class="mark soft"><%= t("guide.marks")[index] %></span>
      <%= link_to t("guide.chapters.#{key}"), guide_chapter_path(key) %>
    </li>
  <% end %>
</ul>

<%# 사경은 여기서 스스로 찾게 둔다. 알림도 배지도 없이, 그냥 거기 있다. %>
<p class="tiny" style="margin-top:3rem">
  <%= t("guide.copying") %>
  <%= link_to t("guide.copying_go"), new_copying_path %>
</p>
