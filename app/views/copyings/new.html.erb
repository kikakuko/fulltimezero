<%# 사경 — 오늘의 한 자. 쓰면 그걸로 한 자다. 채점도 인식도 없다.
    몇 번째 자인지, 이 자가 경에 몇 번 나오는지는 쓰지 않는다 — 세는 일이므로. %>
<%= render "compound/hall_header", key: :copying %>

<% if @char.nil? %>
  <div class="center">
    <p class="lead"><%= t("copyings.finished") %></p>
    <p class="tiny"><%= link_to t("copyings.look"), pagoda_path, class: "soft" %></p>
  </div>
<% elsif @written %>
  <%# 하루 한 자를 이미 썼다. 오늘 몫은 끝났다(제2조).
      쌓인 탑은 언제든 볼 수 있다 — 세는 것을 막는 일은 탑 화면이 한다. %>
  <div class="center">
    <p class="copy-glyph"><%= @char.glyph %></p>
    <p class="lead"><%= t("today.done") %></p>
    <p class="tiny"><%= link_to t("copyings.look"), pagoda_path, class: "soft" %></p>
  </div>
<% else %>
  <div class="copying" data-controller="copying"
       data-copying-vibrate-value="<%= @vibrate %>"
       data-copying-pagoda-value="<%= t("copyings.pagoda") %>">
    <div class="copy-sheet">
      <svg viewBox="0 0 1000 1000" role="img" aria-label="<%= t("copyings.surface", glyph: @char.glyph) %>"
           data-copying-target="surface"
           data-action="pointerdown->copying#down pointermove->copying#move pointerup->copying#up pointercancel->copying#up">
        <text class="copy-model" x="500" y="540" text-anchor="middle" dominant-baseline="middle"><%= @char.glyph %></text>
        <g class="copy-strokes" data-copying-target="strokes"></g>
      </svg>
    </div>

    <div class="copy-offer">
      <button type="button" class="quiet" data-action="copying#clear"><%= t("copyings.rewrite") %></button>

      <%= form_with url: copyings_path, scope: :copying, data: { action: "submit->copying#offer" } do |f| %>
        <%= f.hidden_field :glyph_paths, value: "", data: { copying_target: "field" } %>
        <%= f.submit t("copyings.offer"), disabled: true, data: { copying_target: "offer" } %>
      <% end %>
    </div>

    <%# 탑의 그림. 올린 뒤 장면에서만 쓰이므로 여기서는 그려지지 않는다 —
        그때 가서 부르면 탑이 한 박자 늦게 서기 때문에 미리 심어 둔다. %>
    <template data-copying-target="art"><%= pagoda_outline %></template>

    <%# 언어별 칸은 모델의 *_here 가 정한다(Localized). 훈음은 한국어에서만,
        뜻은 그 언어로, 영어 풀이는 뜻이 영어가 아닐 때만 곁에. %>
    <dl class="copy-notes">
      <% if @char.reading_here %>
        <dt><%= t("copyings.reading") %></dt>
        <dd><%= @char.reading_here %></dd>
      <% end %>

      <% if @char.transliterated? %>
        <%# 소리를 옮긴 자에는 뜻 대신 원어를 둔다. %>
        <dt><%= t("copyings.sanskrit") %></dt>
        <dd>
          <%= @char.sanskrit["word"] %> · <%= @char.sanskrit["syllable"] %>
          <% if @char.sound_here %> · <%= @char.sound_here %><% end %>
        </dd>
      <% else %>
        <dt><%= t("copyings.sense") %></dt>
        <dd><%= @char.sense_here_here %></dd>
      <% end %>

      <dt><%= t("copyings.phrase") %></dt>
      <dd class="copy-phrase"><% @char.phrase.chars.each do |char| %><%= char == @char ? tag.strong(char.glyph) : char.glyph %><% end %></dd>

      <% if @char.gloss_beside %>
        <dt><%= t("copyings.english") %></dt>
        <dd><%= @char.gloss_beside %></dd>
      <% end %>
    </dl>

    <% if @again %>
      <p class="tiny"><%= t("copyings.again", phrase: @again.han) %></p>
    <% end %>

    <p class="tiny"><%= link_to t("copyings.look"), pagoda_path, class: "soft" %></p>
  </div>
<% end %>
