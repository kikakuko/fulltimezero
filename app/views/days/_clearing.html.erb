<%# 비움의 손짓. 오늘이면 그 손짓 안에서 기기가 떨고(게이트), 켜 두었으면 종성이 울리고,
    미륵이 솟는 장면이 실린다. 다른 날은 오가는 손짓뿐이다. %>
<% if @today %>
  <div class="tiny clearing" id="clearing" data-controller="maitreya">
    <%= button_to t(@cleared ? "days.unclear" : "days.clear"),
                  day_path(@date), method: :patch, class: "button-quiet",
                  data: { action: "click->clearing#declare click->bell#open click->maitreya#rise" },
                  form: { data: { controller: "clearing bell",
                                  clearing_vibrate_value: @vibrate, clearing_declaring_value: !@cleared,
                                  bell_enabled_value: @clearing_bell && !@cleared,
                                  bell_start_url_value: bell_source(:start) } } %>

    <%# 미륵이 솟는 장면. 누르는 순간 화면이 물러나고 땅과 미륵만 남는다.
        넉 초에 전부 멎는다. 한 줄은 처음 비운 날과 다 올라온 날에만. %>
    <% if @maitreya_rise %>
      <% before, after = @maitreya_rise %>
      <template data-maitreya-target="scene">
        <div class="maitreya-scene" role="presentation">
          <div class="maitreya-scene__ground">
            <%= render "days/maitreya", reading: after, before: before %>
          </div>
          <div class="maitreya-scene__below">
            <% if after.first || after.whole %>
              <p class="maitreya-scene__line"><%= t("maitreya.line") %></p>
            <% end %>
            <p class="maitreya-scene__back"><%= link_to t("maitreya.back"), today_path, class: "soft" %></p>
          </div>
        </div>
      </template>
    <% end %>
  </div>
<% else %>
  <%= button_to @cleared ? t("days.unclear") : t("days.clear"),
                day_path(@date), method: :patch, class: "button-quiet" %>
<% end %>
