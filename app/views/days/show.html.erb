<%# 하루. 적고 지우는 것 말고 할 일이 없다. %>
<%# 날짜 숫자는 언제나 .date 안에만 있다. 화면의 다른 어디에도 숫자는 없다. %>
<h1 class="title">
  <%= month_name(@date) %>
  <span class="date"><%= @date.day %></span>
  <span class="soft"><%= weekday_name(@date.wday) %></span>
</h1>

<% if @plans.any? %>
  <ul class="plans">
    <% @plans.each do |plan| %>
      <li>
        <span><%= plan.what %></span>
        <%= button_to t("days.remove"), plan_path(plan), method: :delete, class: "quiet" %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="lead"><%= @cleared ? t("days.cleared") : t("days.day_empty") %></p>
<% end %>

<%= form_with model: Plan.new, url: plans_path do |f| %>
  <%= f.hidden_field :planned_on, value: @date.iso8601 %>
  <div class="field">
    <%= f.label :what, t("days.add") %>
    <%= f.text_field :what, maxlength: Plan::MOST, autocomplete: "off" %>
  </div>
  <p><%= f.submit t("days.save") %></p>
<% end %>

<%# 그 날 남긴 쉼과 앉음. 쉼 기록은 사용자의 것이므로 한 줄씩 지울 수
    있다(§4). 지운 것은 되돌릴 수 없으니 한 번만 묻는다. %>
<% if @rests.any? || @sittings.any? %>
  <hr class="rule">

  <h2 class="title"><%= t("days.kept") %></h2>
  <ul class="plans">
    <% @rests.each do |rest| %>
      <li>
        <span><%= [ t("rests.durations.#{rest.duration}"),
                    (t("rests.textures.#{rest.texture}") if rest.texture) ].compact.join(" · ") %></span>
        <%= button_to t("days.remove"), rest_path(rest), method: :delete, class: "quiet",
                      form: { data: { turbo_confirm: t("days.forget_confirm") } } %>
      </li>
    <% end %>

    <% @sittings.each do |sitting| %>
      <li>
        <span><%= t("days.kinds.#{sitting.mode}") %></span>
        <%= button_to t("days.remove"), sitting_path(sitting), method: :delete, class: "quiet",
                      form: { data: { turbo_confirm: t("days.forget_confirm") } } %>
      </li>
    <% end %>
  </ul>
<% end %>

<hr class="rule">

<%= button_to @cleared ? t("days.unclear") : t("days.clear"),
              day_path(@date), method: :patch, class: "quiet" %>

<p class="tiny" style="margin-top:2.5rem">
  <%= link_to t("days.back"), days_path(month: @date.strftime("%Y-%m")), class: "soft" %>
</p>
