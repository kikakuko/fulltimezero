<%# This app is a raft. — 이 앱도 뗏목이다. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# 기기의 다크 모드를 따르지 않는다 — 어둠은 문과 몰입 화면의 것이다(SPIRIT §2). %>
    <meta name="color-scheme" content="light">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="fulltimezero">
    <%# 미리 받지 않는다. 손을 올려놓기만 해도 요청이 나가는 것은 이 앱의 결이 아니고(§4),
        달의 응답 · 낙관의 찍힘 · 절처럼 한 번의 사건을 flash 로 넘기는 장면을 미리 받기가
        먼저 가져가면 그 사건이 사라진다(flash_once_test). 링크가 적어 잃는 것도 없다. %>
    <meta name="turbo-prefetch" content="false">
    <%# 전각에 드는 전환 — 마당과 전각 화면에만. 떠나는 화면과 오는 화면이 둘 다 이것을 가질 때
        Turbo 가 View Transition 으로 갈아 끼운다(docs/M-entry-design.md). 움직임을 줄인 화면에서는
        Turbo 가 스스로 끈다. 문 셋과 몰입 화면에는 두지 않는다. %>
    <% if content_for?(:entry) %>
      <meta name="view-transition" content="same-origin">
    <% end %>
    <%# 아직 보여 줄 때가 아니다 — 기본은 검색에 막음(SearchGate). %>
    <% if SearchGate.closed? %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# 나라 밖으로 펼칠 때 — 같은 화면의 언어 셋(ko · en · x-default)과 링크 그림 한 장.
        둘 다 자기 주소다(바깥이 아니다). 그림은 로케일마다, 없으면 ko 로 떨어진다. %>
    <% I18n.available_locales.each do |locale| %>
      <%= tag.link rel: "alternate", hreflang: locale, href: alternate_url(locale) %>
    <% end %>
    <%= tag.link rel: "alternate", hreflang: "x-default", href: alternate_url(I18n.default_locale) %>
    <%= tag.meta property: "og:image", content: image_url(og_image_path) %>
    <%= tag.meta property: "og:image:width", content: "1200" %>
    <%= tag.meta property: "og:image:height", content: "630" %>

    <%= yield :head %>

    <%# 아이콘 — 한지 위의 먹빛 코끼리. 주사는 없다(manifest_test). %>
    <%= tag.link rel: "icon", href: asset_path("icon.svg"), type: "image/svg+xml" %>
    <%= tag.link rel: "apple-touch-icon", href: asset_path("apple-touch-icon.png"), sizes: "180x180" %>
    <%= tag.link rel: "manifest", href: "/manifest.json" %>

    <%# 미리 받는 글꼴은 첫 화면의 큰 글 하나(동해독도)뿐이다 — 나머지는 화면의 글자가 부른다. %>
    <%= tag.link rel: "preload", as: "font", type: "font/woff2", crossorigin: "anonymous", href: asset_path("EastSeaDokdo.woff2") %>
    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# 매일 지나는 문. 첫째 문의 빛이 짧게 다가와 한 번 넘치고, 가라앉으면
        그대로 마당이다. 글은 없다. 아무 곳이나 누르면 곧장 끝난다. %>
    <% if daily_door_due? %>
      <div class="daily-door" data-controller="daily-door" data-light="<%= Current.user.gate_light %>"
           data-action="click->daily-door#pass animationend->daily-door#settled" aria-hidden="true">
        <div class="gates__frame">
          <%= image_tag "gates.webp", class: "gates__image", alt: "", draggable: false %>
          <span class="gates__light"></span>
          <%= render "onboarding/plaque", door: "stop" %>
        </div>
        <span class="gates__flood"></span>
        <span class="gates__dim"></span>
      </div>
    <% end %>

    <% unless content_for?(:no_chrome) %>
      <header class="chrome">
        <%= link_to t("app.name"), authenticated? ? today_path : gate_path %>
        <% if authenticated? %>
          <nav><%= link_to t("nav.settings"), settings_path %></nav>
        <% end %>
      </header>
    <% end %>

    <main class="sheet">
      <% if flash[:notice] || flash[:alert] %>
        <p class="flash"><%= flash[:notice] || flash[:alert] %></p>
      <% end %>

      <%# 손님임을 처음에 밝힌다. §3 은 쌓인 것이 무너지지 않는다고 했으니, 적었다가
          사라지면 배신이다. 말없이 무너뜨리는 것이 §3 이 막는 일이고, 미리 밝히는
          것은 다르다. 숫자도 날짜도 적지 않는다. %>
      <% if guest? %>
        <p class="tiny"><%= t("guest.line") %></p>
      <% end %>

      <%= yield %>

      <% unless content_for?(:no_locales) %>
        <p class="locales">
          <% User::LOCALES.each_with_index do |l, i| %><%= " · " if i.positive? %><%=
            l == I18n.locale.to_s ? tag.span(t("locales.#{l}")) : link_to(t("locales.#{l}"), url_for(locale: l))
          %><% end %>
        </p>
      <% end %>
    </main>

    <%# 네 개의 문. 낮고 조용하게 아래에 둔다 — 주인공은 달과 물음이고
        문들은 그 밑에 선다. 몰입 화면(앉는 중 · 무위 · 기록 직후)에는
        내비가 없다. 성역에는 나가는 길만 있으면 된다. %>
    <% if authenticated? && !content_for?(:no_chrome) %>
      <nav class="doors">
        <%# 자리 넷 — 도상 넷과 하나씩 마주 선다: 달 · 미륵 · 코끼리 · 탑.
            「쉼의 안내」는 문이 아니라 오늘 안의 길이다. %>
        <% { today: today_path, days: days_path,
             sitting: new_sitting_path, copying: new_copying_path }.each do |name, path| %>
          <%= link_to t("nav.#{name}"), path,
                      class: class_names("door", here: current_page?(path)) %>
        <% end %>
      </nav>
    <% end %>
  </body>
</html>
