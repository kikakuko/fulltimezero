<%# 법이 적으라 한 것을 이 앱의 말투로 적는다 — PIPA 제30조(필수 기재사항)와
    GDPR 제13조(수령인의 범주). 숫자는 화면에 두지 않으므로 나이도 날수도
    글자로 적는다.

    가입이 닫혀 있는 동안에는 모으는 개인정보가 없다. 그때는 빈칸을 보이지
    않는다 — {{CPO_NAME}} · {{HOST_NAME}} 같은 자리가 공개 화면에 뜨면
    깨진 것으로 보인다. 문구는 미리 적어 두고(locales), 가입을 열 때 선다. %>
<h1 class="title"><%= t("privacy.title") %></h1>

<div class="guide">
  <% if SignupGate.closed? %>
    <p><%= t("privacy.closed_note") %></p>
  <% end %>

  <% %w[collect own export delete third_party].each do |key| %>
    <p><%= t("privacy.#{key}") %></p>
  <% end %>

  <h2 class="section"><%= t("privacy.keeping.title") %></h2>
  <p><%= t("privacy.keeping.body") %></p>

  <h2 class="section"><%= t("privacy.rights.title") %></h2>
  <p>
    <%= t("privacy.rights.body") %>
    <%= SignupGate.open? ? t("privacy.rights.by_mail") : t("privacy.rights.by_mail_not_yet") %>
  </p>

  <% %w[disposal safety].each do |section| %>
    <h2 class="section"><%= t("privacy.#{section}.title") %></h2>
    <p><%= t("privacy.#{section}.body") %></p>
  <% end %>

  <h2 class="section"><%= t("privacy.trustees.title") %></h2>
  <% if SignupGate.closed? %>
    <p><%= t("privacy.trustees.none") %></p>
  <% else %>
    <p><%= t("privacy.trustees.body") %></p>

    <%# TODO: 맡는 곳이 정해지면 locales 의 privacy.trustees.server_who 의
        {{HOST_NAME}} 과 두는 자리를 채운다. 맡기기 전에 처리위탁 계약서를 받는다. %>
    <table class="trustees">
      <thead>
        <tr>
          <th><%= t("privacy.trustees.work") %></th>
          <th><%= t("privacy.trustees.who") %></th>
          <th><%= t("privacy.trustees.where") %></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= t("privacy.trustees.server") %></td>
          <td><%= t("privacy.trustees.server_who") %></td>
          <td><%= t("privacy.trustees.undecided") %></td>
        </tr>
        <tr>
          <td><%= t("privacy.trustees.mail") %></td>
          <td><%= t("privacy.trustees.undecided") %></td>
          <td><%= t("privacy.trustees.undecided") %></td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <h2 class="section"><%= t("privacy.age.title") %></h2>
  <p><%= t("privacy.age.body") %></p>

  <h2 class="section"><%= t("privacy.officer.title") %></h2>
  <% if SignupGate.closed? %>
    <p><%= t("privacy.officer.closed") %></p>
  <% else %>
    <p>
      <%= t("privacy.officer.body") %>
      <%= mail_to t("privacy.officer.mail") %>
    </p>
  <% end %>
</div>
